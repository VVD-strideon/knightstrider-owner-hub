{
  "name": "Lead",
  "type": "object",
  "properties": {
    "first_name": {
      "type": "string",
      "description": "Lead's first name"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Lead's email address"
    },
    "phone": {
      "type": "string",
      "description": "Optional phone number"
    },
    "villa_resort": {
      "type": "string",
      "description": "Villa or resort name"
    },
    "consent": {
      "type": "boolean",
      "default": false,
      "description": "Marketing consent given"
    },
    "source": {
      "type": "string",
      "default": "landing_page",
      "description": "Lead acquisition source"
    }
  },
  "required": [
    "first_name",
    "email"
  ]
}